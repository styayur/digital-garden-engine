                  "value": "html",
                  "label": "Content format",
                  "preserveUnknown": true
                },
                "body": {
                  "id": "prop-body-dcbf42a35db9",
                  "key": "body",
                  "type": "rich-text",
                  "value": "<p>This fictional profile demonstrates direct HTML editing in a supported garden section.</p>\n<aside class=\"about-note\" data-preserved=\"true\"><strong>Preserved structure.</strong> Unknown safe elements and data attributes travel with the document.</aside>\n<rhizome-note data-preserved=\"true\">This custom element remains in source mode until it is intentionally converted.</rhizome-note>\n<h2>How this project is organised</h2>\n<p>Content, layout, theme and publication state are separate. The editor changes a stable project model, never the rendered DOM.</p>\n<ul><li>Writing and project notes remain portable.</li><li>Drafts and private records are excluded from publishable exports.</li><li>Source mode remains available when a visual block needs special handling.</li></ul>",
                  "label": "Content",
                  "preserveUnknown": true
                },
                "documentId": {
                  "id": "prop-documentid-88618abcd520",
                  "key": "documentId",
                  "type": "text",
                  "value": "doc-about-profile",
                  "label": "Linked document",
                  "preserveUnknown": true
                }
              },
              "settings": {}
            }
          ],
          "settings": {}
        }
      ],
