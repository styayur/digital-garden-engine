{
  "name": "rhizomaybor",
  "version": "0.5.0",
  "private": false,
  "description": "A reusable, constrained visual editor and static website builder for digital gardens and personal sites.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-full.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && vitest run",
    "content:validate": "node scripts/validate-content.mjs",
    "content:stage": "node scripts/stage-content.mjs",
    "build:public": "node scripts/build-public.mjs",
    "build:example": "node scripts/build-public.mjs --source examples/content --output-dir out",
    "build:static": "node scripts/build-public.mjs",
    "check:links": "node scripts/check-links.mjs",
    "artifact:audit": "node scripts/artifact-audit.mjs",
    "test:publication-boundary": "node --test tests/publication-boundary.test.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "project:migrate": "tsx scripts/migrate-content.ts",
    "project:validate": "tsx scripts/validate-project.ts",
    "build:project": "tsx scripts/build-project.ts",
    "export:project": "tsx scripts/export-project.ts --mode project",
    "export:website": "tsx scripts/export-project.ts --mode website",
    "verify:7z": "tsx scripts/verify-7z.ts",
    "build:pages": "node scripts/build-pages.mjs",
    "desktop:dev": "tauri dev --config src-tauri/tauri.conf.json",
    "desktop:build": "tauri build --config src-tauri/tauri.conf.json",
    "desktop:test": "node scripts/prepare-desktop-test.mjs",
    "desktop:icons": "tauri icon docs/assets/brand/logo-mark.svg -o src-tauri/icons"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@muyajs/core": "^0.2.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "7z-wasm": "^1.2.0",
    "dompurify": "^3.4.17",
    "framer-motion": "^14.9.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.1.3",
    "next": "^16.4.4",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-highlight": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "autoprefixer": "^10.6.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.2"
  },
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/styayur/rhizomaybor.git"
  },
  "homepage": "https://github.com/styayur/rhizomaybor#readme",
  "bugs": {
    "url": "https://github.com/styayur/rhizomaybor/issues"
  },
  "keywords": [
    "digital-garden",
    "website-builder",
    "visual-editor",
    "static-site",
    "markdown",
    "tauri",
    "7z"
  ],
  "author": "Rhizomaybor contributors"
}
