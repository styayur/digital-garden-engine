# Optional full-development admin. The public static build never includes /admin or /api.
ADMIN_PASSWORD=change-me
ADMIN_SECRET=replace-with-a-long-random-string

# Public canonical URL used by feeds, sitemap and metadata.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: point development and validation at another content repository.
# DIGITAL_GARDEN_SOURCE_ROOT=../my-private-garden
